{% extends 'base.html.twig' %}

{% block title %}Add Address{% endblock %}

{% block body %}
    <div class="container mt-4">
        <h1>Add Address</h1>

        {{ form_start(form) }}
        <div class="mb-3">
            {{ form_label(form.country) }}
            {{ form_widget(form.country, { attr: { class: 'form-select' } }) }}
            {{ form_errors(form.country) }}
        </div>

        <div class="mb-3">
            {{ form_label(form.city) }}
            {{ form_widget(form.city, { attr: { class: 'form-select' } }) }}
            {{ form_errors(form.city) }}
        </div>

        <div class="mb-3">
            {{ form_label(form.streetName) }}
            {{ form_widget(form.streetName, { attr: { class: 'form-control', rows: 2 } }) }}
            {{ form_errors(form.streetName) }}
        </div>

        <div class="mb-3">
            {{ form_label(form.postcode) }}
            {{ form_widget(form.postcode, { attr: { class: 'form-control', pattern: '\\d*' } }) }}
            {{ form_errors(form.postcode) }}
        </div>

        <button class="btn btn-success">Save</button>
        <a href="{{ path('app_address_page') }}" class="btn btn-secondary">Cancel</a>
        {{ form_end(form) }}
    </div>
{% endblock %}

{% block javascripts %}
    <script>
        $(document).ready(function () {
            $('#address_country').on('change', function () {
                var countryId = $(this).val();
                var $citySelect = $('#address_city');

                if (!countryId) {
                    $citySelect.html('<option value="">Select Country First</option>');
                    return;
                }

                $.ajax({
                    url: '/get-cities/' + countryId,
                    method: 'GET',
                    dataType: 'json',
                    success: function (data) {
                        $citySelect.empty().append('<option value="">Select City</option>');
                        $.each(data, function (i, city) {
                            $citySelect.append(
                                $('<option></option>').val(city.id).text(city.name)
                            );
                        });
                    },
                    error: function () {
                        $citySelect.html('<option value="">Error loading cities</option>');
                        console.error('Failed to fetch cities from server.');
                    }
                });
            });
        });
    </script>
{% endblock %}

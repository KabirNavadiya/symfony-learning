{% extends 'base.html.twig' %}

{% block title %}City{% endblock %}

{% block body %}
    <div class="container mt-4">
        <div class="d-flex justify-content-between align-items-center mb-4">
            <h1 class="mb-0">Cities</h1>
            <a href="{{ path('app_add_city') }}" class="btn btn-primary">+ Add City</a>
        </div>

        {% for flash in app.flashes('success') %}
            <div class="alert alert-success alert-dismissible fade show" role="alert">
                {{ flash }}
            </div>
        {% endfor %}

        {% for flash in app.flashes('error') %}
            <div class="alert alert-danger alert-dismissible fade show" role="alert">
                {{ flash }}
            </div>
        {% endfor %}

        <form method="get" class="row g-3 mb-4">
            <div class="col-md-4">
                <input type="text" name="search" value="{{ search }}" class="form-control" placeholder="Search City Name...">
            </div>
            <div class="col-md-3">
                <select name="country" class="form-select">
                    <option value="">-- All Countries --</option>
                    {% for country in countries %}
                        <option value="{{ country.id }}" {% if country.id == countryId %}selected{% endif %}>{{ country.name }}</option>
                    {% endfor %}
                </select>
            </div>
            <div class="col-md-3">
                <select name="status" class="form-select">
                    <option value="">-- All Status --</option>
                    <option value="1" {% if status == '1' %}selected{% endif %}>Active</option>
                    <option value="0" {% if status == '0' %}selected{% endif %}>Not Active</option>
                </select>
            </div>
            <div class="col-md-2">
                <button type="submit" class="btn btn-outline-primary w-100">Search</button>
            </div>
        </form>


        <div class="table-responsive">
            <table class="table table-bordered table-hover align-middle">
                <thead class="table-light">
                <tr>
                    <th>ID</th>
                    <th>Name</th>
                    <th>Country</th>
                    <th>Status</th>
                    <th style="width: 180px;">Action</th>
                </tr>
                </thead>
                <tbody>
                {% for city in cities %}
                    <tr>
                        <td>{{ city.id }}</td>
                        <td>{{ city.name }}</td>
                        <td>{{ city.country.name }}</td>
                        <td>
                            {% if city.active %}
                                <span class="badge bg-success">Active</span>
                            {% else %}
                                <span class="badge bg-secondary">Not Active</span>
                            {% endif %}
                        </td>
                        <td>
                            <a href="{{ path('app_edit_city',{ id: city.id}) }}" class="btn btn-sm btn-warning">Edit</a>
                            <form method="post" action="{{ path('app_delete_city',{ id: city.id }) }}" class="d-inline-block" onsubmit="return confirm('Are you sure you want to delete this city?');">
                                <input type="hidden" name="_token" value="{{ csrf_token('delete' ~ city.id) }}">
                                <button class="btn btn-sm btn-danger">Delete</button>
                            </form>
                        </td>
                    </tr>
                {% else %}
                    <tr>
                        <td colspan="5" class="text-center text-muted">No cities found.</td>
                    </tr>
                {% endfor %}
                </tbody>
            </table>
        </div>
    </div>
{% endblock %}
